# Optional: enables the Responses API research assistant. Keep this file private.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
CLARITY_WEB_PORT=8080
# ---------------------------------------------------------------------------
# Production secrets — NEVER commit real values. Copy to `.env` and fill in.
# ---------------------------------------------------------------------------
# Random >=32-char HS256 signing secret (REQUIRED in docker-compose).
CLARITY_JWT_SECRET=
# Comma-separated browser origins allowed to call the API, e.g.
# http://localhost:8080 (empty = dev defaults in backend/main.py).
CLARITY_CORS_ORIGINS=
# Set behind nginx/compose so audit IPs honor X-Forwarded-For; keep false
# for direct `uvicorn` runs so clients cannot spoof their audit IP.
CLARITY_TRUST_PROXY=false
# Initial root admin seed (used once on first boot when set).
ADMIN_EMAIL=
ADMIN_PASSWORD=
